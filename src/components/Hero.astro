---
// src/components/Hero.astro
// Data Modernist hero: full-viewport, 60×60 background grid,
// Conway's Game of Life canvas background, status badge, KPI card,
// and an infinitely-scrolling tech strip anchored to the bottom.

interface Tech {
  name: string;
  slug?: string;   // Simple Icons slug → CDN image
  abbr?: string;   // Fallback monogram if no slug
  color: string;
}

const techs: Tech[] = [
  { name: "Python",           slug: "python",         color: "#3776AB" },
  { name: "Microsoft Azure",  slug: "icloud",          color: "#0078D4" },
  { name: "Javascript",       slug: "javascript",     color: "#74aa9c" },
  { name: "Docker",           slug: "docker",         color: "#2496ED" },
  { name: "Jira",             slug: "jira",           color: "#1C3C3C" },
  { name: "Palantir",         slug: "palantir",       color: "#A0A0A0" },
  { name: "Hugging Face",     slug: "huggingface",    color: "#FFD21E" },
  { name: "Ollama",           slug: "ollama",         color: "#E0E0E0" },
  { name: "LangGraph",        slug: "langgraph",      color: "#1C7A6B" },
];
const doubled = [...techs, ...techs];
---
<section id="hero">

  <!-- 60×60 dot-grid overlay -->
  <div class="bg-grid" aria-hidden="true"></div>

  <!-- Game of Life canvas -->
  <canvas class="gol-canvas" aria-hidden="true"></canvas>

  <!-- Gradient fade so the canvas blends into the page below -->
  <div class="gol-gradient" aria-hidden="true"></div>

  <div class="hero-inner">

    <!-- LEFT: avatar -->
    <div class="hero-avatar-wrap">
      <img
        src="/asaad-avatar.png"
        alt="Asaad — pixel art portrait"
        class="hero-avatar"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- RIGHT: content -->
    <div class="hero-content">
      <!-- <div class="status-badge">
        <span class="pulse-ring" aria-hidden="true"></span>
        <span class="pulse-dot"  aria-hidden="true"></span>
        Available for opportunities
      </div> -->

      <h1><span class="hero-name">Asaad</span></h1>

      <p class="hero-tagline headline-secondary">
        <span>Data & AI, Systems, People</span>
      </p>

      <div class="hero-body">
        <p>
        Agentic AI, Systems Engineering, and Automations built for business outcomes and adoption.     
      </p>
      </div>

      <div class="hero-ctas">
        <a href="/Asaad_Alghamdi_Resume.pdf" class="btn-secondary">Read My Resume</a>
      </div>
    </div>

    <!-- RIGHT: KPI snapshot card -->
