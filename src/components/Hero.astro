          <div class="kpi-meta">
            <span class="kpi-name">Projects Delivered On-Time</span>
            <span class="kpi-value" data-target="94">0<span class="kpi-unit">%</span></span>
          </div>
          <div class="kpi-track" role="progressbar" aria-valuenow="94" aria-valuemin="0" aria-valuemax="100">
            <div class="kpi-fill kpi-fill--blue" style="--pct: 94%"></div>
          </div>
        </div>

        <div class="kpi-metric">
          <div class="kpi-meta">
            <span class="kpi-name">Stakeholder Satisfaction</span>
            <span class="kpi-value kpi-value--amber" data-target="97">0<span class="kpi-unit">%</span></span>
          </div>
          <div class="kpi-track" role="progressbar" aria-valuenow="97" aria-valuemin="0" aria-valuemax="100">
            <div class="kpi-fill kpi-fill--amber" style="--pct: 97%"></div>
          </div>
        </div>

        <div class="kpi-metric">
          <div class="kpi-meta">
            <span class="kpi-name">Research to Production Rate</span>
            <span class="kpi-value kpi-value--green" data-target="89">0<span class="kpi-unit">%</span></span>
          </div>
          <div class="kpi-track" role="progressbar" aria-valuenow="89" aria-valuemin="0" aria-valuemax="100">
            <div class="kpi-fill kpi-fill--green" style="--pct: 89%"></div>
          </div>
        </div>
      </div>

      <div class="kpi-footer">
        <span class="mono-label">ASAAD.METRICS.v2026</span>
      </div>
