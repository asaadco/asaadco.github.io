---
// src/components/Journey.astro — populated from Asaad Alghamdi's resume.
interface Entry {
  role: string;
  org: string;
  date: string;
  impact: string;
  bullets: string[];
}

const entries: Entry[] = [
    {
    role: "Data & AI Lead",
    org: "Deputy CEO Office, NEOM",
    date: "Aug 2024 – Apr 2026",
    impact: "Owned and Built executive-grade AI systems and cloud-native data platforms for NEOM's highest-stakes decisions, while leading engineers across the full AI delivery lifecycle.",
    bullets: [
      "Built and maintained executive decision support systems such as automating risk & compliance for high-value projects with 360° analysis",
      "Engineered and Deployed Data & AI pipelines on Microsoft Fabric",
      "Led engineers as a hands-on technical mentor, setting standards and agile delivery timelines",
    ],
  },
  {
    role: "Data & AI Product Lead",
    org: "Tech & Digital, NEOM",
    date: "Jul 2022 – Aug 2024",
    impact: "Spearheaded NEOM's foundational Arabic LLM — recognised as Saudi Arabia's national champion — and represented NEOM at national events to VVIPs and audiences of 500+.",
    bullets: [
      "Led development of NEOM's Arabic LLM, AraMUS, achieving national champion benchmark performance",
      "Published AraMUS at ACL 2023, a top-tier international NLP conference",
      "Delivered public speeches to 500+ attendees at KAUST, LEAP, and GITEX, representing NEOM's AI vision and capabilities",
    ],
  },
    {
    role: "M.Sc. Computer Science",
    org: "King Abdullah University of Science & Technology (KAUST)",
    date: "2020 – 2022",
    impact: "Deepened expertise in NLP and AI systems at KAUST, one of the region's top research institutions,  directly laying the groundwork for technical leadership in LLM space.",
    bullets: [
      "Graduate research in NLP, GANs, and distributed systems",
      "Reviewed papers for top-tier conferences including ACL and NeurIPS",
      "Teaching Assistant for introductory graduate-level courses"
    ],
  },
    {
    role: "Lead Researcher",
    org: "Deanship of Research, KFUPM",
    date: "2018 – 2021",
    impact: "Managed $17,000+ in research grants as Principal Investigator across Systems and Machine Learning — producing peer-reviewed publications at international venues.",
    bullets: [
      "Managed $17,000+ in research grants as Principal Investigator",
      "Led multiple research projects spanning Systems and Machine Learning domains",
      "Published outcomes at peer-reviewed international conferences including Mobicom 2020, CoRR 2021",
    ],
  },
    {
    role: "Automation Engineer Intern",
    org: "Innovation Team, Saudi Aramco",
    date: "Jun – Aug 2019",
    impact: "Self-initiated OpenCV and automation projects projected to save ~$500,000 annually, demonstrating entrepreneurial drive within one of the world's largest energy companies.",
    bullets: [
      "Proposed and implemented OpenCV-based automation entirely on personal initiative",
      "Projected $500,000 in annual cost savings by automating core business processes"],
  },
    {
    role: "B.Sc. Computer Science — Honours",
    org: "King Fahd University of Petroleum & Minerals",
    date: "2015 – 2020",
    impact: "Graduated with Distinction, building deep foundations in algorithms, systems, and machine learning while concurrently leading university research as Principal Investigator.",
    bullets: [
      "Graduated with B.Sc. Honors in Computer Science",
      "Principal Investigator for multiple ML & Systems research projects",
      "Laid the technical foundation for a career at the frontier of AI research and engineering",
    ],
  }
];
---
<section>
  <div class="inner">
    <header class="section-header">
      <span class="section-tag">Career</span>
      <h2>Experience Timeline</h2>
      <p class="section-sub">From Honours graduate to national AI lead — a decade of compounding impact.</p>
    </header>

    <ol class="timeline" aria-label="Career timeline">
      {entries.map((entry, i) => (
        <li class={`timeline-entry${i % 2 === 1 ? " even" : ""}`}>

          <div class="entry-dot" aria-hidden="true">
            <div class="dot-ring"></div>
            <div class="dot-core"></div>
          </div>

          <details class="timeline-card">
            <summary>
              <div class="card-top">
                <div class="card-meta">
                  <h3 class="entry-role">{entry.role}</h3>
                  <p class="entry-org">{entry.org}</p>
                </div>
                <div class="card-right">
                  <span class="entry-date">{entry.date}</span>
                </div>
              </div>
              <p class="entry-impact">{entry.impact}</p>
              <span class="expand-cta" aria-hidden="true">
                <span class="cta-show">Show highlights →</span>
                <span class="cta-hide">Hide ↑</span>
              </span>
            </summary>
            <ul class="entry-bullets">
              {entry.bullets.map(b => <li>{b}</li>)}
            </ul>
          </details>

        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  section {
    background-color: var(--color-bg);
    padding: var(--space-3xl) var(--space-xl);
    position: relative;
  }

  .inner { max-width: 1100px; margin: 0 auto; }

  .section-header { text-align: center; margin-bottom: var(--space-3xl); }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-blue);
    margin-bottom: var(--space-sm);
  }

  h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .section-sub { font-size: 15px; color: var(--color-text-muted); }

  /* ─── Timeline ─────────────────────────────────── */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    left: calc(50% - 1px);
    width: 2px;
    background: linear-gradient(to bottom, var(--color-blue), transparent);
    pointer-events: none;
  }

  .timeline-entry {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    margin-bottom: var(--space-2xl);
  }

  .timeline-entry.even { justify-content: flex-end; }

  .entry-dot {
    position: absolute;
    top: 18px;
    left: calc(50% - 8px);
    width: 16px; height: 16px;
    pointer-events: none;
    z-index: 1;
  }

  .dot-core {
    position: absolute; inset: 0;
    border-radius: 50%;
    background-color: var(--color-blue);
    border: 2px solid var(--color-bg);
  }

  .dot-ring {
    position: absolute; inset: -5px;
    border-radius: 50%;
    border: 2px solid rgba(30, 144, 255, 0.4);
    animation: pulse-node 2.4s ease-out infinite;
  }

  @keyframes pulse-node {
    0%   { transform: scale(1);   opacity: 0.8; }
    100% { transform: scale(2.2); opacity: 0;   }
  }

  .timeline-card {
    width: calc(50% - 48px);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .timeline-entry:not(.even) .timeline-card { margin-right: 48px; }
  .timeline-entry.even .timeline-card       { margin-left: 48px; }

  .timeline-card:hover,
  details[open].timeline-card {
    border-color: rgba(30, 144, 255, 0.45);
    box-shadow: 0 0 0 3px rgba(30, 144, 255, 0.07);
  }

  details summary {
    list-style: none;
    padding: var(--space-lg);
    cursor: pointer;
    user-select: none;
  }

  details summary::-webkit-details-marker { display: none; }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .entry-role {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  .entry-org {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-blue);
    margin-top: 2px;
    letter-spacing: 0.04em;
  }

  .card-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .expand-cta {
    display: inline-block;
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-blue);
    letter-spacing: 0.05em;
    opacity: 0.65;
    transition: opacity 0.2s var(--ease);
  }

  .timeline-card:hover .expand-cta,
  details[open] .expand-cta { opacity: 1; }

  .cta-hide { display: none; }
  details[open] .cta-show { display: none; }
  details[open] .cta-hide { display: inline; }

  .entry-impact {
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .entry-bullets {
    list-style: none;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .entry-bullets li {
    font-size: 13px;
    color: var(--color-text);
    line-height: 1.5;
    padding-left: var(--space-lg);
    position: relative;
  }

  .entry-bullets li::before {
    content: '';
    position: absolute;
    left: 0; top: 8px;
    width: 8px; height: 1px;
    background-color: var(--color-blue);
  }

  /* ─── Mobile ───────────────────────────────────── */
  @media (max-width: 767px) {
    section { padding: var(--space-3xl) var(--space-md); }

    .timeline { padding-left: 40px; }
    .timeline::before { left: 15px; }

    .timeline-entry,
    .timeline-entry.even { justify-content: flex-start; }

    .entry-dot { left: -32px; }

    .timeline-card,
    .timeline-entry:not(.even) .timeline-card,
    .timeline-entry.even .timeline-card {
      width: 100%;
      margin-right: 0;
      margin-left: 0;
    }
  }
</style>
