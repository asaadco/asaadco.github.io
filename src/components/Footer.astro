---
// src/components/Footer.astro
// Data Modernist footer: surface background, mono copyright, thin top border.
---
<footer>
  <div class="inner">
    <span class="logo"><span class="logo-accent">A</span>saad</span>
    <p class="copy">
      <span class="mono">© 2026 ASAAD ALGHAMDI. ALL RIGHTS RESERVED.</span>
    </p>
    <span class="status mono">v2026.1</span>
  </div>
</footer>

<style>
  footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding: var(--space-lg) var(--space-xl);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .logo-accent {
    color: var(--color-blue);
  }

  .copy {
    flex: 1;
    text-align: center;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .status {
    text-align: right;
  }

  @media (max-width: 600px) {
    footer {
      padding: var(--space-lg) var(--space-md);
    }
    .inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-sm);
    }
    .status {
      text-align: center;
    }
  }
</style>
