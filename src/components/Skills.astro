---
// src/components/Skills.astro
interface SkillCard {
  icon: string;
  iconColor: string;
  title: string;
  chips: string[];
}

interface Cert {
  name: string;
  issuer: string;
  year: string;
  url?: string;
}

const skills: SkillCard[] = [
  {
    icon: "◈",
    iconColor: "#1E90FF",
    title: "LLMs & NLP",
    chips: ["LLMs", "NLP", "Visual LLM", "LangChain", "LangGraph", "Prompt Engineering"],
  },
  {
    icon: "⟁",
    iconColor: "#F4A261",
    title: "Cloud & Data Platforms",
    chips: ["Microsoft Azure", "Microsoft Fabric", "Palantir Foundry", "Data Lakehouse", "Pipeline Design"],
  },
  {
    icon: "◉",
    iconColor: "#4ADE80",
    title: "AI Engineering",
    chips: ["Python", "OpenCV", "Computer Vision", "Process Automation", "Embedded Systems", "Product Design"],
  },
  {
    icon: "▦",
    iconColor: "#F4A261",
    title: "Leadership & Delivery",
    chips: ["Technical Mentoring", "OKR Alignment", "Agile / Scrum", "Cross-functional Teams", "Executive Comms"],
  },
];

// Ordered by impact: brand recognition → seniority level → recency
const certs: Cert[] = [
  {
    name: "Microsoft Certified: Azure AI Engineer Associate",
    issuer: "Microsoft",
    year: "2025",
    url: "https://learn.microsoft.com/api/credentials/share/en-us/AsaadAlGhamdi-4118/5F8E2018CEEAF4DA?sharingId=F01C74CEC0944BBA",
  },
  {
    name: "Certified Palantir Foundry Data Engineer Professional",
    issuer: "Palantir Technologies",
    year: "2026",
    url: "https://verify.skilljar.com/c/xe4hj7upev39",
  },
  {
    name: "Certified Palantir Foundry Application Developer Professional",
    issuer: "Palantir Technologies",
    year: "2025",
    url: "https://verify.skilljar.com/c/mqx7j7j4qdfm",
  },
  {
    name: "Essential Management Skills for Emerging Leaders",
    issuer: "Harvard — Professional & Executive Development",
    year: "2024",
  },
  {
    name: "Certified ScrumMaster (CSM)",
    issuer: "Scrum Alliance",
    year: "2025",
    url: "https://certification.scrumalliance.org/accounts/1766349-asaad-alghamdi/certifications/2094786-csm",
  },
  {
    name: "CCX 2: Customer Insights & Analytics",
    issuer: "Bain & Company",
    year: "2025",
    url: "https://learn.bainacademy.com/c/eeQLCZk9TwOZJLoJNxLQdQ",
  },
  {
    name: "CCX 1: Winning Through Customer Experience",
    issuer: "Bain & Company",
    year: "2025",
    url: "https://learn.bainacademy.com/c/V9SRrjH6Td-XutK2_wg7FA",
  },
  {
    name: "Certified Palantir Foundry Aware Professional",
    issuer: "Palantir Technologies",
    year: "2025",
    url: "https://verify.skilljar.com/c/fzpd6xnsfnbr",
  },
  {
    name: "Foundry & AIP Builder Foundations",
    issuer: "Palantir Technologies",
    year: "2025",
    url: "https://verify.skilljar.com/c/bfcunbgmj3ix",
  },
  {
    name: "Asana Foundations Skill Badge",
    issuer: "Asana",
    year: "2025",
    url: "https://certifications.asana.com/a5909add-fb2a-489f-a785-cc322a3b6abb",
  },
];
---
<section id="skills">
  <div class="inner">
    <header class="section-header">
      <span class="section-tag">Expertise</span>
      <h2>Skill Grid</h2>
      <p class="section-sub">Tools and disciplines built across research, engineering, and national-scale AI delivery.</p>
    </header>

    <div class="skill-grid">

      {/* ── Skill cards ── */}
      {skills.map(card => (
        <div class="skill-card">
          <div class="card-header">
            <div
              class="icon-box"
              style={`background: ${card.iconColor}1a; color: ${card.iconColor};`}
              aria-hidden="true"
            >
              {card.icon}
            </div>
            <h3 class="card-title">{card.title}</h3>
          </div>
          <div class="chip-list">
            {card.chips.map(chip => (
              <span class="skill-chip">{chip}</span>
            ))}
          </div>
        </div>
      ))}

      {/* ── Certifications — spans cols 2-3 of row 2 ── */}
      <div class="skill-card cert-card">
        <div class="card-header">
          <div class="icon-box" style="background: #1E90FF1a; color: #1E90FF;" aria-hidden="true">◎</div>
          <h3 class="card-title">Certifications</h3>
          <span class="cert-count">{certs.length} verified</span>
        </div>

        <ul class="cert-list">
          {certs.map(cert => (
            <li class="cert-row">
              {cert.url ? (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-link"
                  aria-label={`View credential: ${cert.name}`}
                >
                  <span class="cert-info">
                    <span class="cert-name">{cert.name}</span>
                    <span class="cert-issuer">{cert.issuer}</span>
                  </span>
                  <span class="cert-right">
                    <span class="cert-year">{cert.year}</span>
                    <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class="cert-arrow">
                      <path d="M15 1v6h-2V4.41L7.41 10 6 8.59 11.59 3H9V1zm-4 10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h2V3H5a3 3 0 0 0-3 3v5a3 3 0 0 0 3 3h5a3 3 0 0 0 3-3V9h-2z"/>
                    </svg>
                  </span>
                </a>
              ) : (
                <div class="cert-link cert-link--static">
                  <span class="cert-info">
                    <span class="cert-name">{cert.name}</span>
                    <span class="cert-issuer">{cert.issuer}</span>
                  </span>
                  <span class="cert-right">
                    <span class="cert-year">{cert.year}</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  section {
    background-color: var(--color-bg);
    padding: var(--space-3xl) var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .inner { max-width: 1200px; margin: 0 auto; }

  .section-header { text-align: center; margin-bottom: var(--space-3xl); }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-amber);
    margin-bottom: var(--space-sm);
  }

  h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .section-sub { font-size: 15px; color: var(--color-text-muted); }

  /* ─── Grid: 3 cols; row 1 = 3 skill cards, row 2 = Leadership + cert (span 2) ── */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  /* ── Common card styles ── */
  .skill-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .skill-card:hover {
    border-color: rgba(30, 144, 255, 0.35);
    box-shadow: 0 4px 24px var(--color-blue-glow);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .icon-box {
    width: 40px; height: 40px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.3;
  }

  /* ── Skill chips ── */
  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .skill-chip {
    display: inline-block;
    position: relative;
    padding: 4px 10px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    overflow: hidden;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .skill-chip::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 2px;
    background-color: var(--color-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .skill-chip:hover {
    background-color: rgba(30, 144, 255, 0.12);
    border-color: var(--color-blue);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .skill-chip:hover::after { transform: scaleX(1); }

  /* ── Certifications card (spans cols 2-3) ── */
  .cert-card {
    grid-column: span 2;
  }

  .cert-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-blue);
    background: rgba(30, 144, 255, 0.08);
    border: 1px solid rgba(30, 144, 255, 0.2);
    border-radius: 20px;
    padding: 2px 10px;
    white-space: nowrap;
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px var(--space-lg);
  }

  .cert-row { display: flex; }

  .cert-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    width: 100%;
    padding: 7px 8px;
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s var(--ease);
  }

  a.cert-link:hover {
    background-color: rgba(30, 144, 255, 0.07);
  }

  a.cert-link:hover .cert-name {
    color: var(--color-blue);
  }

  a.cert-link:hover .cert-arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  .cert-link--static { cursor: default; }

  .cert-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cert-name {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
    transition: color 0.2s var(--ease);
  }

  .cert-issuer {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cert-right {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .cert-year {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .cert-arrow {
    color: var(--color-blue);
    opacity: 0.5;
    flex-shrink: 0;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .skill-grid { grid-template-columns: repeat(2, 1fr); }
    /* cert-card keeps span 2 — fills both cols of its row */
    .cert-list { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    section { padding: var(--space-3xl) var(--space-md); }
    .skill-grid { grid-template-columns: 1fr; }
    .cert-card { grid-column: span 1; }
    .cert-list { grid-template-columns: 1fr; }
  }
</style>
