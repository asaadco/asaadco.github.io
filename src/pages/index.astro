---
// src/pages/index.astro
// Data Modernist single-page layout: Hero → Metrics → Journey → Skills → Projects → Contact
// Nav and Footer are rendered by Layout.
import Layout   from "../layouts/Layout.astro";
import Hero     from "../components/Hero.astro";
import Metrics  from "../components/Metrics.astro";
import Journey  from "../components/Journey.astro";
import Skills   from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Contact  from "../components/Contact.astro";
---
<Layout title="Asaad - Data & AI">
  <Hero />
  <div id="journey">
    <Metrics />
    <Journey />
  </div>
  <Skills />
  <Projects />
  <Contact />
</Layout>
